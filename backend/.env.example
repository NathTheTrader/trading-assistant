PORT=3000
FRONTEND_ORIGIN=https://naththetrader.github.io
# Optional stronger private API key; keep this value only in Railway/server env and EDGEFLOW Settings.
EDGEFLOW_ACCESS_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REASONING=false
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=4000
OBSIDIAN_DAILY_REQUEST_BUDGET=35
DATA_FILE=./data/trades.json

TRADOVATE_API_URL=https://live.tradovateapi.com/v1
TRADOVATE_WS_URL=wss://live.tradovateapi.com/v1/websocket
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0.0
TRADOVATE_CID=
TRADOVATE_SEC=

# Private server-side Obsidian memory
OBSIDIAN_DIR=./data/obsidian
